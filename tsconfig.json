{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "esnext.temporal"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["src", "vitest.config.ts", "vitest.setup.ts"]
}
