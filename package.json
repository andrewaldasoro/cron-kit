{
  "name": "cron-toolkit",
  "version": "1.0.0",
  "description": "Cron toolkit: parse, validate, describe (en/es/fr), and compute next runs in any time zone. Quartz and Unix dialects, zero dependencies, built on Temporal and Intl.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./describe": {
      "types": "./dist/describe.d.ts",
      "import": "./dist/describe.js"
    },
    "./schedule": {
      "types": "./dist/schedule.d.ts",
      "import": "./dist/schedule.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewaldasoro/cron-toolkit.git"
  },
  "homepage": "https://github.com/andrewaldasoro/cron-toolkit#readme",
  "bugs": {
    "url": "https://github.com/andrewaldasoro/cron-toolkit/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "keywords": [
    "cron",
    "quartz",
    "crontab",
    "schedule",
    "next-run",
    "timezone",
    "temporal",
    "describe",
    "i18n",
    "validator"
  ],
  "author": "Andrew Aldasoro",
  "license": "ISC",
  "packageManager": "pnpm@11.16.0",
  "devDependencies": {
    "oxlint": "^1.76.0",
    "temporal-polyfill": "^1.0.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
